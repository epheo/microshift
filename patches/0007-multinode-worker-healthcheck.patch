+++ b/pkg/healthcheck/own_node_test.go
@@ -0,0 +1,64 @@
+package healthcheck
+
+import (
+	"context"
+	"testing"
+
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/kubernetes/fake"
+	"k8s.io/utils/ptr"
+)
+
+func TestOwnNodeDaemonSetPodReady(t *testing.T) {
+	ds := &appsv1.DaemonSet{
+		TypeMeta:   metav1.TypeMeta{APIVersion: "apps/v1", Kind: "DaemonSet"},
+		ObjectMeta: metav1.ObjectMeta{Name: "ovnkube-node", Namespace: "ovn", UID: types.UID("ds-uid")},
+		Spec:       appsv1.DaemonSetSpec{Selector: &metav1.LabelSelector{MatchLabels: map[string]string{"app": "ovnkube-node"}}},
+	}
+	owner := []metav1.OwnerReference{{APIVersion: "apps/v1", Kind: "DaemonSet", Name: ds.Name, UID: ds.UID, Controller: ptr.To(true)}}
+	rev := func(name, hash string, n int64) *appsv1.ControllerRevision {
+		return &appsv1.ControllerRevision{
+			ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "ovn", OwnerReferences: owner,
+				Labels: map[string]string{"app": "ovnkube-node", appsv1.DefaultDaemonSetUniqueLabelKey: hash}},
+			Revision: n,
+		}
+	}
+	pod := func(name, node, hash string, ready bool) *corev1.Pod {
+		st := corev1.ConditionFalse
+		if ready {
+			st = corev1.ConditionTrue
+		}
+		return &corev1.Pod{
+			ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "ovn", OwnerReferences: owner,
+				Labels: map[string]string{"app": "ovnkube-node", appsv1.DefaultDaemonSetUniqueLabelKey: hash}},
+			Spec:   corev1.PodSpec{NodeName: node},
+			Status: corev1.PodStatus{Conditions: []corev1.PodCondition{{Type: corev1.PodReady, Status: st}}},
+		}
+	}
+	revs := []runtime.Object{rev("r1", "old", 1), rev("r2", "new", 2)}
+
+	tests := []struct {
+		name string
+		objs []runtime.Object
+		want bool
+	}{
+		{"own pod ready on newest revision, worker pod down", []runtime.Object{pod("a", "cp", "new", true), pod("b", "worker", "old", false)}, true},
+		{"own pod on an old revision", []runtime.Object{pod("a", "cp", "old", true)}, false},
+		{"own pod not ready, worker pod ready", []runtime.Object{pod("a", "cp", "new", false), pod("b", "worker", "new", true)}, false},
+		{"no pod on this node", []runtime.Object{pod("b", "worker", "new", true)}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cs := fake.NewSimpleClientset(append(append([]runtime.Object{}, revs...), tt.objs...)...)
+			c := &ownNodeCheck{nodeName: "cp", apps: cs.AppsV1(), core: cs.CoreV1()}
+			got, err := c.daemonSetPodReady(context.Background(), ds)
+			if got != tt.want {
+				t.Fatalf("daemonSetPodReady() = %v (%v), want %v", got, err, tt.want)
+			}
+		})
+	}
+}
diff --git a/pkg/healthcheck/worker.go b/pkg/healthcheck/worker.go
new file mode 100644
index 0000000000000000000000000000000000000000..49597e79e7b7472b56138f6edcecf1c8c36b0140
--- /dev/null
+++ b/pkg/healthcheck/worker.go
@@ -0,0 +1,49 @@
+package healthcheck
+
+import (
+	"context"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/tools/clientcmd"
+	"k8s.io/klog/v2"
+
+	"github.com/openshift/microshift/pkg/config"
+)
+
+// workerNodeShouldBeReady gates a worker on its own Node object; the kubelet
+// credentials are the only ones a worker holds, and the Node authorizer only
+// lets them read the node itself.
+func workerNodeShouldBeReady(ctx context.Context, timeout time.Duration) error {
+	cfg, err := config.ActiveConfig()
+	if err != nil {
+		return err
+	}
+	restConfig, err := clientcmd.BuildConfigFromFlags("", cfg.KubeConfigPath(config.Kubelet))
+	if err != nil {
+		return err
+	}
+	client, err := kubernetes.NewForConfig(restConfig)
+	if err != nil {
+		return err
+	}
+
+	nodeName := cfg.CanonicalNodeName()
+	klog.Infof("Waiting %v for node %s to be ready", timeout, nodeName)
+	return wait.PollUntilContextTimeout(ctx, 5*time.Second, timeout, true, func(ctx context.Context) (bool, error) {
+		node, err := client.CoreV1().Nodes().Get(ctx, nodeName, metav1.GetOptions{})
+		if err != nil {
+			klog.V(2).Infof("Failed to get node %s: %v", nodeName, err)
+			return false, nil
+		}
+		for _, cond := range node.Status.Conditions {
+			if cond.Type == corev1.NodeReady {
+				return cond.Status == corev1.ConditionTrue, nil
+			}
+		}
+		return false, nil
+	})
+}
