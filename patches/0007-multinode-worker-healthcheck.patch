diff --git a/pkg/healthcheck/own_node.go b/pkg/healthcheck/own_node.go
new file mode 100644
index 0000000000000000000000000000000000000000..9d9cd913adf18941ace48f6fc9feaf87f540e341
--- /dev/null
+++ b/pkg/healthcheck/own_node.go
@@ -0,0 +1,82 @@
+package healthcheck
+
+import (
+	"context"
+	"fmt"
+
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	appsclientv1 "k8s.io/client-go/kubernetes/typed/apps/v1"
+	coreclientv1 "k8s.io/client-go/kubernetes/typed/core/v1"
+
+	"github.com/openshift/microshift/pkg/config"
+)
+
+// ownNodeCheck judges a DaemonSet by the pod on this node only. On a
+// multinode control plane a NotReady worker keeps its pods unavailable and
+// its rollout stuck; counting them would fail this node's greenboot and
+// roll the control plane back over another machine's outage.
+type ownNodeCheck struct {
+	nodeName string
+	apps     appsclientv1.AppsV1Interface
+	core     coreclientv1.CoreV1Interface
+}
+
+func newOwnNodeCheck(apps appsclientv1.AppsV1Interface, core coreclientv1.CoreV1Interface) (*ownNodeCheck, error) {
+	cfg, err := config.ActiveConfig()
+	if err != nil {
+		return nil, err
+	}
+	return &ownNodeCheck{nodeName: cfg.CanonicalNodeName(), apps: apps, core: core}, nil
+}
+
+// daemonSetPodReady reports whether this node's pod of ds is Ready and on
+// the DaemonSet's newest revision; the error explains a false result.
+func (c *ownNodeCheck) daemonSetPodReady(ctx context.Context, ds *appsv1.DaemonSet) (bool, error) {
+	selector, err := metav1.LabelSelectorAsSelector(ds.Spec.Selector)
+	if err != nil {
+		return false, err
+	}
+	pods, err := c.core.Pods(ds.Namespace).List(ctx, metav1.ListOptions{
+		LabelSelector: selector.String(),
+		FieldSelector: "spec.nodeName=" + c.nodeName,
+	})
+	if err != nil {
+		return false, err
+	}
+	revs, err := c.apps.ControllerRevisions(ds.Namespace).List(ctx, metav1.ListOptions{LabelSelector: selector.String()})
+	if err != nil {
+		return false, err
+	}
+	var newest *appsv1.ControllerRevision
+	for i := range revs.Items {
+		r := &revs.Items[i]
+		if !metav1.IsControlledBy(r, ds) {
+			continue
+		}
+		if newest == nil || r.Revision > newest.Revision {
+			newest = r
+		}
+	}
+	if newest == nil {
+		return false, fmt.Errorf("no controller revision yet")
+	}
+	hash := newest.Labels[appsv1.DefaultDaemonSetUniqueLabelKey]
+
+	for _, pod := range pods.Items {
+		if pod.Spec.NodeName != c.nodeName || !metav1.IsControlledBy(&pod, ds) || pod.DeletionTimestamp != nil {
+			continue
+		}
+		if pod.Labels[appsv1.DefaultDaemonSetUniqueLabelKey] != hash {
+			return false, fmt.Errorf("pod %s on node %s is not on the newest revision yet", pod.Name, c.nodeName)
+		}
+		for _, cond := range pod.Status.Conditions {
+			if cond.Type == corev1.PodReady && cond.Status == corev1.ConditionTrue {
+				return true, nil
+			}
+		}
+		return false, fmt.Errorf("pod %s on node %s is not ready", pod.Name, c.nodeName)
+	}
+	return false, fmt.Errorf("no pod on node %s yet", c.nodeName)
+}
diff --git a/pkg/healthcheck/own_node_test.go b/pkg/healthcheck/own_node_test.go
