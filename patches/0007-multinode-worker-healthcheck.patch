+// WorkerMarkerPath is written by 'add-node --worker' so role-agnostic tools
+// (healthcheck, greenboot) can tell a worker from a control plane node.
+func WorkerMarkerPath() string {
+	return filepath.Join(DataDir, "multinode-worker")
+}
+
+func IsWorkerNode() bool {
+	exists, err := util.PathExists(WorkerMarkerPath())
+	return err == nil && exists
+}
