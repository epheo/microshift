+// fetchCertificateAuthorityCert writes only the public certificate of a CA.
+func fetchCertificateAuthorityCert(ctx context.Context, client kubernetes.Interface, name, dir string) error {
+	secret, err := client.CoreV1().Secrets("kube-system").Get(ctx, name, metav1.GetOptions{})
+	if err != nil {
+		return fmt.Errorf("failed to get %s secret: %w", name, err)
+	}
+
+	caCert, exists := secret.Data["ca.crt"]
+	if !exists {
+		return fmt.Errorf("ca.crt not found in secret")
+	}
+
+	if err := os.MkdirAll(dir, 0750); err != nil {
+		return fmt.Errorf("failed to create destination directory: %w", err)
+	}
+
+	if err := os.WriteFile(cryptomaterial.CACertPath(dir), caCert, 0600); err != nil {
+		return fmt.Errorf("failed to write ca.crt: %w", err)
+	}
+
+	if caBundle, ok := secret.Data["ca-bundle.crt"]; ok {
+		if err := os.WriteFile(cryptomaterial.CABundlePath(dir), caBundle, 0600); err != nil {
+			return fmt.Errorf("failed to write ca-bundle.crt: %w", err)
+		}
+	}
+
+	return nil
+}
+
+// writeKubeletClientCABundle mirrors the kubelet client CA bundle that
+// initCerts builds on nodes holding the signer keys.
+func writeKubeletClientCABundle() error {
+	certsDir := cryptomaterial.CertsDirectory(config.DataDir)
+	members := []string{
+		cryptomaterial.KubeControlPlaneSignerCertDir(certsDir),
+		cryptomaterial.KubeAPIServerToKubeletSignerCertDir(certsDir),
+		cryptomaterial.AdminKubeconfigSignerDir(certsDir),
+		cryptomaterial.KubeletCSRSignerSignerCertDir(certsDir),
+		cryptomaterial.CSRSignerCertDir(certsDir),
+	}
+	bundle := []byte{}
+	for _, dir := range members {
+		pemBytes, err := os.ReadFile(cryptomaterial.CACertPath(dir))
+		if err != nil {
+			return err
+		}
+		bundle = append(bundle, pemBytes...)
+		if len(pemBytes) > 0 && pemBytes[len(pemBytes)-1] != '\n' {
+			bundle = append(bundle, '\n')
+		}
+	}
+	path := cryptomaterial.KubeletClientCAPath(certsDir)
+	if err := os.MkdirAll(filepath.Dir(path), 0750); err != nil {
+		return err
+	}
+	return os.WriteFile(path, bundle, 0600)
+}
