diff --git a/pkg/cmd/addnode_worker.go b/pkg/cmd/addnode_worker.go
new file mode 100644
index 0000000000000000000000000000000000000000..8ea05a0d6160a5c346504677792f025711a81212
--- /dev/null
+++ b/pkg/cmd/addnode_worker.go
@@ -0,0 +1,175 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"path/filepath"
+
+	"github.com/openshift/microshift/pkg/config"
+	"github.com/openshift/microshift/pkg/util"
+	"github.com/openshift/microshift/pkg/util/cryptomaterial"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/tools/clientcmd"
+	"k8s.io/klog/v2"
+)
+
+// runAddWorker replaces upstream's runAddNode for this build: a node joins
+// as a worker, with kubelet and networking only and no signing material.
+// Full etcd-replica joins are refused before anything on the node is wiped:
+// the etcd ports a replica needs are firewalled here.
+func runAddWorker(ctx context.Context, opts *AddNodeOptions) error {
+	if !opts.Worker {
+		return fmt.Errorf("full etcd-replica joins are not supported on this build; re-run with --worker")
+	}
+	ctx, cancel := context.WithTimeout(ctx, opts.Timeout)
+	defer cancel()
+
+	klog.Info("Starting worker join...")
+	cfg, err := config.ActiveConfig()
+	if err != nil {
+		return fmt.Errorf("failed to load MicroShift configuration: %w", err)
+	}
+	client, err := createKubernetesClient(opts.KubeconfigPath)
+	if err != nil {
+		return fmt.Errorf("failed to create Kubernetes client: %w", err)
+	}
+
+	// The join is the only thing that writes a worker's local state (CA
+	// certs, kubelet CA bundle, bootstrap kubeconfig, marker). If that state
+	// is gone (node re-provisioned, or a failed join that already removed its
+	// bootstrap kubeconfig) the join runs again even though the Node object
+	// exists. Only a worker whose kubelet finished bootstrapping short-circuits.
+	nodeName := cfg.CanonicalNodeName()
+	if isNodeAlreadyInCluster(ctx, client, nodeName) {
+		bootstrapped, err := util.PathExists(cfg.KubeConfigPath(config.Kubelet))
+		if err != nil {
+			return fmt.Errorf("failed to check the kubelet kubeconfig: %w", err)
+		}
+		if config.IsWorkerNode() && bootstrapped {
+			klog.Infof("Node %s is already part of the cluster. Skipping join process.", nodeName)
+			return nil
+		}
+		klog.Infof("Node %s exists in the cluster but local worker state is missing; re-materializing bootstrap materials", nodeName)
+	}
+
+	// A worker newer than the control plane would join outside the version
+	// skew policy: refuse before anything on this node is wiped.
+	if err := checkWorkerSkew(opts.KubeconfigPath, true); err != nil {
+		return err
+	}
+
+	if err := cleanupMicroShiftData(cfg); err != nil {
+		return fmt.Errorf("failed to cleanup MicroShift data directories: %w", err)
+	}
+
+	// The kubelet's client CA bundle is the only CA material a worker needs:
+	// the apiserver's CA comes with the join kubeconfig, and the kubelet
+	// gets its own certificates through CSRs.
+	caPath := cryptomaterial.KubeletClientCAPath(cryptomaterial.CertsDirectory(config.DataDir))
+	if err := fetchKubeletClientCA(ctx, client, caPath); err != nil {
+		return fmt.Errorf("failed to fetch the kubelet client CA bundle: %w", err)
+	}
+	klog.Info("Kubelet client CA bundle fetched")
+
+	if err := configureBootstrapKubeconfig(cfg, opts.KubeconfigPath); err != nil {
+		return fmt.Errorf("failed to configure bootstrap kubeconfig: %w", err)
+	}
+	// The bootstrap kubeconfig is a copy of the passed-in credential (a join
+	// token, or cluster-admin): remove it however the join ends. On success
+	// the kubelet holds its own rotating client cert; a failed join is
+	// re-run with add-node, which copies it again.
+	defer func() {
+		if err := os.Remove(cfg.BootstrapKubeConfigPath()); err != nil && !os.IsNotExist(err) {
+			klog.Warningf("failed to remove the bootstrap kubeconfig: %v", err)
+		}
+	}()
+
+	// The role marker drives role-agnostic tools (healthcheck, greenboot) and
+	// carries the control plane's routable IP: the worker routes the virtual
+	// apiserver advertise address through it, and the bootstrap kubeconfig,
+	// gone after the join, is the only other place that knows it.
+	cpIP, err := resolveControlplaneIP(opts.KubeconfigPath)
+	if err != nil {
+		return fmt.Errorf("failed to resolve the control plane address: %w", err)
+	}
+	if err := os.WriteFile(config.WorkerMarkerPath(), []byte(cpIP+"\n"), 0600); err != nil {
+		return fmt.Errorf("failed to write worker marker: %w", err)
+	}
+
+	if err := restartMicroShift(); err != nil {
+		return fmt.Errorf("failed to restart MicroShift service: %w", err)
+	}
+	klog.Info("MicroShift service restarted")
+
+	if err := waitForNodeReady(ctx, client, nodeName); err != nil {
+		return fmt.Errorf("node failed to become ready: %w", err)
+	}
+
+	klog.Info("Node successfully joined the cluster")
+	// add-node does not delete a file it was handed, but this one should not
+	// outlive the join.
+	klog.Warningf("%s is no longer needed: delete it", opts.KubeconfigPath)
+	return nil
+}
+
+// resolveControlplaneIP returns the address of the apiserver the kubeconfig's
+// current context points at.
+func resolveControlplaneIP(kubeconfigPath string) (string, error) {
+	kc, err := clientcmd.LoadFromFile(kubeconfigPath)
+	if err != nil {
+		return "", err
+	}
+	kctx, ok := kc.Contexts[kc.CurrentContext]
+	if !ok {
+		return "", fmt.Errorf("kubeconfig %s has no current context", kubeconfigPath)
+	}
+	cluster, ok := kc.Clusters[kctx.Cluster]
+	if !ok || cluster.Server == "" {
+		return "", fmt.Errorf("kubeconfig %s: context %q names no cluster with a server", kubeconfigPath, kc.CurrentContext)
+	}
+	u, err := url.Parse(cluster.Server)
+	if err != nil {
+		return "", err
+	}
+	host := u.Hostname()
+	if ip := net.ParseIP(host); ip != nil {
+		return ip.String(), nil
+	}
+	addrs, err := net.LookupHost(host)
+	if err != nil {
+		return "", err
+	}
+	if len(addrs) == 0 {
+		return "", fmt.Errorf("cannot resolve control plane host %q", host)
+	}
+	// Prefer v4: the advertise address the worker routes through it is v4
+	// unless the cluster is single-stack v6.
+	for _, a := range addrs {
+		if ip := net.ParseIP(a); ip != nil && ip.To4() != nil {
+			return ip.String(), nil
+		}
+	}
+	return addrs[0], nil
+}
+
+// fetchKubeletClientCA writes the bundle KubeletCAManager publishes on the
+// control plane; KubeletClientCARefresh keeps it current afterwards.
+func fetchKubeletClientCA(ctx context.Context, client kubernetes.Interface, path string) error {
+	cm, err := client.CoreV1().ConfigMaps("kube-system").Get(ctx, "kubelet-client-ca", metav1.GetOptions{})
+	if err != nil {
+		return err
+	}
+	bundle := cm.Data["ca.crt"]
+	if bundle == "" {
+		return fmt.Errorf("kube-system/kubelet-client-ca has no ca.crt yet")
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0750); err != nil {
+		return err
+	}
+	return os.WriteFile(path, []byte(bundle), 0600)
+}
