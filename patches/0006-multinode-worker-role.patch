index 19d5f9b1..4ea84eb1 100644
--- a/pkg/util/kubeconfig.go
+++ b/pkg/util/kubeconfig.go
@@ -16,6 +16,8 @@ limitations under the License.
 package util
 
 import (
+	"fmt"
+
 	clientcmd "k8s.io/client-go/tools/clientcmd"
 	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
 )
@@ -56,3 +58,21 @@ func KubeConfigWithClientCerts(
 
 	return clientcmd.WriteToFile(kubeConfig, path)
 }
+
+// KubeConfigServerURL returns the cluster server URL of the kubeconfig's
+// current context.
+func KubeConfigServerURL(path string) (string, error) {
+	kc, err := clientcmd.LoadFromFile(path)
+	if err != nil {
+		return "", err
+	}
+	kcContext, ok := kc.Contexts[kc.CurrentContext]
+	if !ok {
+		return "", fmt.Errorf("kubeconfig %s has no current context", path)
+	}
+	cluster, ok := kc.Clusters[kcContext.Cluster]
+	if !ok || cluster.Server == "" {
+		return "", fmt.Errorf("kubeconfig %s has no server for cluster %q", path, kcContext.Cluster)
+	}
+	return cluster.Server, nil
+}
