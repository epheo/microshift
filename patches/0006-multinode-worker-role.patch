@@ -0,0 +1,50 @@
+package cmd
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/client-go/kubernetes/fake"
+)
+
+func TestFetchKubeletClientCA(t *testing.T) {
+	cm := func(data string) runtime.Object {
+		return &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{Name: "kubelet-client-ca", Namespace: "kube-system"},
+			Data:       map[string]string{"ca.crt": data},
+		}
+	}
+	tests := []struct {
+		name    string
+		objects []runtime.Object
+		wantErr bool
+	}{
+		{name: "not published", wantErr: true},
+		{name: "published empty", objects: []runtime.Object{cm("")}, wantErr: true},
+		{name: "published", objects: []runtime.Object{cm("-----BEGIN CERTIFICATE-----\n")}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "kubelet", "ca.crt")
+			err := fetchKubeletClientCA(context.Background(), fake.NewSimpleClientset(tt.objects...), path)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("err = %v, wantErr %v", err, tt.wantErr)
+			}
+			got, readErr := os.ReadFile(path)
+			if tt.wantErr {
+				if readErr == nil {
+					t.Fatalf("wrote %q on error", got)
+				}
+				return
+			}
+			if string(got) != "-----BEGIN CERTIFICATE-----\n" {
+				t.Fatalf("wrote %q", got)
+			}
+		})
+	}
+}
