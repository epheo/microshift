+package controllers
+
+import (
+	"context"
+	"os"
+	"time"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/tools/clientcmd"
+	"k8s.io/klog/v2"
+
+	"github.com/openshift/microshift/pkg/config"
+	"github.com/openshift/microshift/pkg/util/cryptomaterial"
+)
+
+// KubeletClientCARefresh keeps a worker's kubelet client CA bundle current.
+// kubelet-ca-manager on the control plane publishes the live bundle to the
+// kube-system/kubelet-client-ca configmap; a worker holds no signing keys and
+// otherwise only ever gets the copy written once at join time, so after the
+// control plane rotates its signers (ShortLived CAs are yearly) the static
+// bundle would stop trusting apiserver-to-kubelet client certs. Best-effort:
+// any failure is logged and never blocks the node.
+type KubeletClientCARefresh struct {
+	kubeconfigPath string
+	caPath         string
+}
+
+func NewKubeletClientCARefresh(cfg *config.Config) *KubeletClientCARefresh {
+	return &KubeletClientCARefresh{
+		kubeconfigPath: cfg.KubeConfigPath(config.Kubelet),
+		caPath:         cryptomaterial.KubeletClientCAPath(cryptomaterial.CertsDirectory(config.DataDir)),
+	}
+}
+
+func (r *KubeletClientCARefresh) Name() string           { return "kubelet-client-ca-refresh" }
+func (r *KubeletClientCARefresh) Dependencies() []string { return []string{"kubelet"} }
+
+func (r *KubeletClientCARefresh) Run(ctx context.Context, ready chan<- struct{}, stopped chan<- struct{}) error {
+	defer close(stopped)
+	close(ready)
+
+	ticker := time.NewTicker(time.Hour)
+	defer ticker.Stop()
+	for {
+		r.syncOnce(ctx)
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-ticker.C:
+		}
+	}
+}
+
+func (r *KubeletClientCARefresh) syncOnce(ctx context.Context) {
+	restConfig, err := clientcmd.BuildConfigFromFlags("", r.kubeconfigPath)
+	if err != nil {
+		klog.V(2).Infof("kubelet-client-ca-refresh: no kubeconfig yet: %v", err)
+		return
+	}
+	client, err := kubernetes.NewForConfig(restConfig)
+	if err != nil {
+		klog.V(2).Infof("kubelet-client-ca-refresh: client: %v", err)
+		return
+	}
+	cm, err := client.CoreV1().ConfigMaps(kubeletCAConfigMapNamespace).Get(ctx, kubeletCAConfigMapName, metav1.GetOptions{})
+	if err != nil {
+		klog.V(2).Infof("kubelet-client-ca-refresh: get configmap: %v", err)
+		return
+	}
+	want := cm.Data[kubeletCAFileName]
+	if want == "" {
+		return
+	}
+	if have, err := os.ReadFile(r.caPath); err == nil && string(have) == want {
+		return
+	}
+	// Atomic replace; kubelet picks the new bundle up via its dynamic CA
+	// reload, or at the latest on the next restart.
+	tmp := r.caPath + ".tmp"
+	if err := os.WriteFile(tmp, []byte(want), 0600); err != nil {
+		klog.Warningf("kubelet-client-ca-refresh: write: %v", err)
+		return
+	}
+	if err := os.Rename(tmp, r.caPath); err != nil {
+		klog.Warningf("kubelet-client-ca-refresh: rename: %v", err)
+		return
+	}
+	klog.Infof("kubelet-client-ca-refresh: updated %s from %s/%s", r.caPath, kubeletCAConfigMapNamespace, kubeletCAConfigMapName)
+}
diff --git a/pkg/controllers/kubelet_csr_approver.go b/pkg/controllers/kubelet_csr_approver.go
new file mode 100644
index 0000000000000000000000000000000000000000..fafa39d42ccfeab95a668c57aaf72dbc7c9b6895
--- /dev/null
+++ b/pkg/controllers/kubelet_csr_approver.go
@@ -0,0 +1,227 @@
+/*
+Copyright © 2026 MicroShift Contributors
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+	http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+package controllers
+
+import (
+	"context"
+	"crypto/x509"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	certsv1 "k8s.io/api/certificates/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/tools/clientcmd"
+	"k8s.io/klog/v2"
+	k8scert "k8s.io/kubernetes/pkg/apis/certificates"
+
+	"github.com/openshift/microshift/pkg/assets"
+	"github.com/openshift/microshift/pkg/config"
+)
+
+const nodeUserPrefix = "system:node:"
+
+// KubeletCSRApprover approves the CSRs a worker node cannot self-sign: its
+// serving certificate (serverTLSBootstrap) and client certificate renewals.
+// The initial client CSR is created with the bootstrap kubeconfig identity
+// and auto-approved by kube-controller-manager.
+//
+// It also applies the RBAC worker joins rely on: the join token's identity
+// and read access to the kubelet client CA configmap.
+type KubeletCSRApprover struct {
+	kubeconfigPath string
+}
+
+func NewKubeletCSRApprover(cfg *config.Config) *KubeletCSRApprover {
+	return &KubeletCSRApprover{kubeconfigPath: cfg.KubeConfigPath(config.KubeAdmin)}
+}
+
+func (a *KubeletCSRApprover) Name() string           { return "kubelet-csr-approver" }
+func (a *KubeletCSRApprover) Dependencies() []string { return []string{"kube-apiserver"} }
+
+func (a *KubeletCSRApprover) Run(ctx context.Context, ready chan<- struct{}, stopped chan<- struct{}) error {
+	defer close(stopped)
+
+	restConfig, err := clientcmd.BuildConfigFromFlags("", a.kubeconfigPath)
+	if err != nil {
+		return err
+	}
+	client, err := kubernetes.NewForConfig(restConfig)
+	if err != nil {
+		return err
+	}
+	if err := applyWorkerJoinRBAC(ctx, a.kubeconfigPath); err != nil {
+		return fmt.Errorf("kubelet-csr-approver: worker join RBAC: %w", err)
+	}
+	close(ready)
+
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	for {
+		a.approvePending(ctx, client)
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-ticker.C:
+		}
+	}
+}
+
+func (a *KubeletCSRApprover) approvePending(ctx context.Context, client kubernetes.Interface) {
+	csrs, err := client.CertificatesV1().CertificateSigningRequests().List(ctx, metav1.ListOptions{})
+	if err != nil {
+		klog.Errorf("kubelet-csr-approver: failed to list CSRs: %v", err)
+		return
+	}
+	for i := range csrs.Items {
+		csr := &csrs.Items[i]
+		if isResolved(csr) {
+			continue
+		}
+		approve, reason := shouldApprove(ctx, client, csr)
+		if !approve {
+			if reason != "" {
+				klog.V(2).Infof("kubelet-csr-approver: not approving %s: %s", csr.Name, reason)
+			}
+			continue
+		}
+		csr.Status.Conditions = append(csr.Status.Conditions, certsv1.CertificateSigningRequestCondition{
+			Type:           certsv1.CertificateApproved,
+			Status:         corev1.ConditionTrue,
+			Reason:         "AutoApproved",
+			Message:        "auto-approved kubelet certificate for " + csr.Spec.Username,
+			LastUpdateTime: metav1.Now(),
+		})
+		if _, err := client.CertificatesV1().CertificateSigningRequests().UpdateApproval(ctx, csr.Name, csr, metav1.UpdateOptions{}); err != nil {
+			klog.Errorf("kubelet-csr-approver: failed to approve %s: %v", csr.Name, err)
+			continue
+		}
+		klog.Infof("kubelet-csr-approver: approved %s (%s) for %s", csr.Name, csr.Spec.SignerName, csr.Spec.Username)
+	}
+}
+
+func isResolved(csr *certsv1.CertificateSigningRequest) bool {
+	for _, c := range csr.Status.Conditions {
+		if c.Status == corev1.ConditionFalse {
+			continue
+		}
+		if c.Type == certsv1.CertificateApproved || c.Type == certsv1.CertificateDenied {
+			return true
+		}
+	}
+	return false
+}
+
+func shouldApprove(ctx context.Context, client kubernetes.Interface, csr *certsv1.CertificateSigningRequest) (bool, string) {
+	// Only requests made by a node about itself qualify; everything else is
+	// left for a human or another controller.
+	if !slices.Contains(csr.Spec.Groups, "system:nodes") {
+		return false, ""
+	}
+	nodeName := strings.TrimPrefix(csr.Spec.Username, nodeUserPrefix)
+	if nodeName == csr.Spec.Username {
+		return false, ""
+	}
+
+	req, err := k8scert.ParseCSR(csr.Spec.Request)
+	if err != nil {
+		return false, err.Error()
+	}
+	// Bind the certificate identity to the requesting node; the vendored
+	// validators only check the system:node: prefix, not the exact name.
+	if req.Subject.CommonName != csr.Spec.Username {
+		return false, "subject does not match requester"
+	}
+
+	usages := sets.NewString()
+	for _, u := range csr.Spec.Usages {
+		usages.Insert(string(u))
+	}
+
+	switch csr.Spec.SignerName {
+	case certsv1.KubeletServingSignerName:
+		// Enforces org, CN prefix, exact usages, and rejects email/URI SANs.
+		if err := k8scert.ValidateKubeletServingCSR(req, usages); err != nil {
+			return false, err.Error()
+		}
+		return validateServingNames(ctx, client, req, nodeName)
+	case certsv1.KubeAPIServerClientKubeletSignerName:
+		if err := k8scert.ValidateKubeletClientCSR(req, usages); err != nil {
+			return false, err.Error()
+		}
+		return true, ""
+	default:
+		return false, ""
+	}
+}
+
+// validateServingNames requires every serving SAN to be an address the node
+// reports for itself. node.Status.Addresses is self-reported by the kubelet,
+// so this bounds a node to plausible names for itself but cannot stop a node
+// that lies about its own status; a scoped signer is the deeper fix.
+func validateServingNames(ctx context.Context, client kubernetes.Interface, req *x509.CertificateRequest, nodeName string) (bool, string) {
+	node, err := client.CoreV1().Nodes().Get(ctx, nodeName, metav1.GetOptions{})
+	if err != nil {
+		return false, fmt.Sprintf("failed to get node %s: %v", nodeName, err)
+	}
+	allowed := sets.New[string](node.Name)
+	for _, addr := range node.Status.Addresses {
+		allowed.Insert(addr.Address)
+	}
+	for _, dns := range req.DNSNames {
+		if !allowed.Has(dns) {
+			return false, fmt.Sprintf("DNS name %q is not an address of node %s", dns, nodeName)
+		}
+	}
+	for _, ip := range req.IPAddresses {
+		if !allowed.Has(ip.String()) {
+			return false, fmt.Sprintf("IP %q is not an address of node %s", ip.String(), nodeName)
+		}
+	}
+	return true, ""
+}
+
+func applyWorkerJoinRBAC(ctx context.Context, kubeconfigPath string) error {
+	if err := assets.ApplyServiceAccounts(ctx, []string{
+		"core/worker-join-serviceaccount.yaml",
+	}, kubeconfigPath); err != nil {
+		return err
+	}
+	if err := assets.ApplyClusterRoles(ctx, []string{
+		"core/worker-join-clusterrole.yaml",
+	}, kubeconfigPath); err != nil {
+		return err
+	}
+	if err := assets.ApplyClusterRoleBindings(ctx, []string{
+		"core/worker-join-clusterrolebinding.yaml",
+		"core/worker-join-clusterrolebinding-node-bootstrapper.yaml",
+		"core/worker-join-clusterrolebinding-nodeclient.yaml",
+	}, kubeconfigPath); err != nil {
+		return err
+	}
+	if err := assets.ApplyRoles(ctx, []string{
+		"core/kubelet-client-ca-reader-role.yaml",
+	}, kubeconfigPath); err != nil {
+		return err
+	}
+	return assets.ApplyRoleBindings(ctx, []string{
+		"core/kubelet-client-ca-reader-rolebinding.yaml",
+	}, kubeconfigPath)
+}
