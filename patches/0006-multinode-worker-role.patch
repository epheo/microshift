diff --git a/pkg/cmd/run_worker.go b/pkg/cmd/run_worker.go
new file mode 100644
index 0000000000000000000000000000000000000000..dac9ba0c797eb92f9d2f2f0369506cd6bc76c623
--- /dev/null
+++ b/pkg/cmd/run_worker.go
@@ -0,0 +1,133 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"github.com/coreos/go-systemd/daemon"
+	"github.com/openshift/microshift/pkg/admin/prerun"
+	"github.com/openshift/microshift/pkg/config"
+	"github.com/openshift/microshift/pkg/controllers"
+	"github.com/openshift/microshift/pkg/gdp"
+	"github.com/openshift/microshift/pkg/node"
+	"github.com/openshift/microshift/pkg/servicemanager"
+	"github.com/openshift/microshift/pkg/servicemanager/startuprecorder"
+	"github.com/openshift/microshift/pkg/sysconfwatch"
+	"github.com/openshift/microshift/pkg/util"
+	"k8s.io/klog/v2"
+)
+
+// runWorker takes over RunMicroshift after the data backup and restore, on a
+// node joined with `add-node --worker`: kubelet and networking only.
+//
+// It owns the rest of the prerun so worker-only checks can run before the
+// version file is written: a refusal must leave the data as the rollback
+// target expects it.
+//
+// A worker holds no signing material, so there is no cert init, no
+// restart-to-rotate deadline (the kubelet rotates its bootstrapped certs
+// itself) and no kustomizer, metrics provisioning or C2CC routing, which all
+// need the kubeadmin kubeconfig. Services upstream adds later run on the
+// control plane only unless listed here.
+//
+// The prerun steps and the run loop mirror RunMicroshift's: compare them on
+// every rebase.
+func runWorker(cfg *config.Config, startRec *startuprecorder.StartupRecorder, microshiftStart time.Time) error {
+	kubeletKubeconfigExists, err := util.PathExists(cfg.KubeConfigPath(config.Kubelet))
+	if err != nil {
+		return err
+	}
+	if !cfg.BootstrapKubeConfigExists() && !kubeletKubeconfigExists {
+		return fmt.Errorf("worker mode requires the bootstrap kubeconfig installed by 'microshift add-node --worker'")
+	}
+
+	// Before anything is written: a refused update must roll back onto the
+	// data as the previous deployment left it.
+	if err := checkWorkerSkew(workerKubeconfig(cfg), isUpdateBoot()); err != nil {
+		writeLogFileError(preRunFailedLogPath, err)
+		return err
+	}
+	if err := prerun.VersionMetadataManagement(); err != nil {
+		writeLogFileError(preRunFailedLogPath, err)
+		return err
+	}
+	if err := prerun.FeatureGateLockManagement(cfg); err != nil {
+		writeLogFileError(preRunFailedLogPath, err)
+		return err
+	}
+	// Written only after every check above passed, as RunMicroshift does.
+	if err := prerun.WriteVersionMetadata(); err != nil {
+		writeLogFileError(preRunFailedLogPath, err)
+		return err
+	}
+
+	runCtx, runCancel := context.WithCancel(context.Background())
+	m := servicemanager.NewServiceManager(startRec)
+	util.Must(m.AddService(node.NewNetworkConfiguration(cfg)))
+	util.Must(m.AddService(sysconfwatch.NewSysConfWatchController(cfg)))
+	util.Must(m.AddService(node.NewKubeletServer(cfg)))
+	util.Must(m.AddService(gdp.NewGenericDevicePlugin(cfg)))
+	util.Must(m.AddService(controllers.NewKubeletClientCARefresh(cfg)))
+
+	// Held back until the services are ready, as RunMicroshift does.
+	notifySocket := os.Getenv("NOTIFY_SOCKET")
+	_ = os.Unsetenv("NOTIFY_SOCKET")
+
+	startRec.ServicesStart(microshiftStart)
+
+	ready, stopped := make(chan struct{}), make(chan struct{})
+	go func() {
+		klog.Infof("Started %s", m.Name())
+		if err := m.Run(runCtx, ready, stopped); err != nil {
+			klog.Errorf("Stopped %s: %v", m.Name(), err)
+		} else {
+			klog.Infof("%s completed", m.Name())
+		}
+	}()
+
+	sigTerm := make(chan os.Signal, 1)
+	signal.Notify(sigTerm, os.Interrupt, syscall.SIGTERM)
+
+	var serviceErr error
+	select {
+	case <-ready:
+		startRec.MicroshiftReady()
+
+		_ = os.Setenv("NOTIFY_SOCKET", notifySocket)
+		if supported, err := daemon.SdNotify(false, daemon.SdNotifyReady); err != nil {
+			klog.Warningf("error sending sd_notify readiness message: %v", err)
+		} else if supported {
+			klog.Info("sent sd_notify readiness message")
+		} else {
+			klog.Info("service does not support sd_notify readiness messages")
+		}
+
+		select {
+		case <-sigTerm:
+			klog.Info("Interrupt received")
+		case err := <-m.ErrChan():
+			serviceErr = err
+			klog.Infof("Service error: %v", err)
+		}
+	case <-sigTerm:
+		klog.Info("Interrupt received")
+	case err := <-m.ErrChan():
+		serviceErr = err
+		klog.Infof("Service error before ready: %v", err)
+	}
+	klog.Info("MICROSHIFT STOPPING")
+	microshiftStop := time.Now()
+	runCancel()
+
+	select {
+	case <-stopped:
+	case <-time.After(time.Duration(gracefulShutdownTimeout) * time.Second):
+		klog.InfoS("MICROSHIFT STOP TIMED OUT", "since-stop", time.Since(microshiftStop))
+	}
+	klog.InfoS("MICROSHIFT STOPPED", "since-stop", time.Since(microshiftStop))
+	return serviceErr
+}
diff --git a/pkg/cmd/worker_join_kubeconfig.go b/pkg/cmd/worker_join_kubeconfig.go
new file mode 100644
index 0000000000000000000000000000000000000000..1688bee621ca3e5943e09c3625526c35506bd06d
--- /dev/null
+++ b/pkg/cmd/worker_join_kubeconfig.go
@@ -0,0 +1,114 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"time"
+
+	"github.com/openshift/microshift/pkg/config"
+	"github.com/openshift/microshift/pkg/version"
+	"github.com/spf13/cobra"
+
+	authenticationv1 "k8s.io/api/authentication/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/tools/clientcmd"
+	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
+)
+
+const workerJoinServiceAccount = "microshift-worker-join"
+
+// NewWorkerJoinKubeconfigCommand prints, on the control plane, the kubeconfig
+// `add-node --worker` takes: the apiserver's external address and CA, and a
+// short-lived token for the microshift-worker-join service account, in place
+// of the cluster-admin kubeconfig.
+func NewWorkerJoinKubeconfigCommand() *cobra.Command {
+	var address string
+	duration := time.Hour
+
+	cmd := &cobra.Command{
+		Use:   "worker-join-kubeconfig",
+		Short: "Print a short-lived kubeconfig for 'add-node --worker' (run on the control plane)",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			return printWorkerJoinKubeconfig(cmd.Context(), cmd.OutOrStdout(), address, duration)
+		},
+	}
+	cmd.Flags().StringVar(&address, "address", "",
+		"Control plane address the worker reaches; one of its kubeconfigs under resources/kubeadmin (default: the node IP)")
+	cmd.Flags().DurationVar(&duration, "duration", duration,
+		"Token lifetime, 10m or more")
+
+	if version.Get().BuildVariant != version.BuildVariantCommunity {
+		cmd.Hidden = true
+	}
+	return cmd
+}
+
+func printWorkerJoinKubeconfig(ctx context.Context, out io.Writer, address string, duration time.Duration) error {
+	// The apiserver refuses shorter service account tokens.
+	if duration < 10*time.Minute {
+		return fmt.Errorf("--duration must be at least 10m")
+	}
+	if config.IsWorkerNode() {
+		return fmt.Errorf("run this on the control plane, not on a worker")
+	}
+	cfg, err := config.ActiveConfig()
+	if err != nil {
+		return fmt.Errorf("failed to load MicroShift configuration: %w", err)
+	}
+	if address == "" {
+		address = cfg.Node.NodeIP
+	}
+
+	// MicroShift writes one kubeconfig per name its serving certificate
+	// covers: reusing its cluster entry keeps the server and CA right.
+	external, err := clientcmd.LoadFromFile(cfg.KubeConfigAdminPath(address))
+	if err != nil {
+		return fmt.Errorf("no kubeconfig for address %q (its apiserver certificate may not cover it): %w", address, err)
+	}
+	kctx, ok := external.Contexts[external.CurrentContext]
+	if !ok {
+		return fmt.Errorf("%s has no current context", cfg.KubeConfigAdminPath(address))
+	}
+	cluster, ok := external.Clusters[kctx.Cluster]
+	if !ok {
+		return fmt.Errorf("%s: context %q names no cluster", cfg.KubeConfigAdminPath(address), external.CurrentContext)
+	}
+
+	restConfig, err := clientcmd.BuildConfigFromFlags("", cfg.KubeConfigPath(config.KubeAdmin))
+	if err != nil {
+		return err
+	}
+	client, err := kubernetes.NewForConfig(restConfig)
+	if err != nil {
+		return err
+	}
+	seconds := int64(duration.Seconds())
+	tr, err := client.CoreV1().ServiceAccounts("kube-system").CreateToken(ctx, workerJoinServiceAccount,
+		&authenticationv1.TokenRequest{Spec: authenticationv1.TokenRequestSpec{ExpirationSeconds: &seconds}},
+		metav1.CreateOptions{})
+	if err != nil {
+		return fmt.Errorf("failed to create a token for kube-system/%s: %w", workerJoinServiceAccount, err)
+	}
+
+	kubeconfig := clientcmdapi.NewConfig()
+	kubeconfig.Clusters["microshift"] = cluster
+	kubeconfig.AuthInfos[workerJoinServiceAccount] = &clientcmdapi.AuthInfo{Token: tr.Status.Token}
+	kubeconfig.Contexts["microshift-worker-join"] = &clientcmdapi.Context{
+		Cluster:  "microshift",
+		AuthInfo: workerJoinServiceAccount,
+	}
+	kubeconfig.CurrentContext = "microshift-worker-join"
+	data, err := clientcmd.Write(*kubeconfig)
+	if err != nil {
+		return err
+	}
+	if _, err := out.Write(data); err != nil {
+		return err
+	}
+	fmt.Fprintf(os.Stderr, "Join kubeconfig for %s, valid until %s\n",
+		cluster.Server, tr.Status.ExpirationTimestamp.Format(time.RFC3339))
+	return nil
+}
diff --git a/pkg/cmd/worker_skew.go b/pkg/cmd/worker_skew.go
new file mode 100644
index 0000000000000000000000000000000000000000..a0b9270e961048795ed256d39a6668b819b2647f
--- /dev/null
+++ b/pkg/cmd/worker_skew.go
@@ -0,0 +1,112 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/openshift/microshift/pkg/admin/prerun"
+	"github.com/openshift/microshift/pkg/config"
+	"github.com/openshift/microshift/pkg/util"
+	utilversion "k8s.io/apimachinery/pkg/util/version"
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/client-go/discovery"
+	"k8s.io/client-go/tools/clientcmd"
+	componentversion "k8s.io/component-base/version"
+	"k8s.io/klog/v2"
+)
+
+// The Kubernetes version skew policy: a kubelet must never be newer than the
+// kube-apiserver, and may be up to three minors older. Updates go control
+// plane first, then nodes.
+// https://kubernetes.io/releases/version-skew-policy/
+const maxKubeletMinorsBehind = 3
+
+// skewVerdict says whether a worker whose kubelet is at kubelet may start
+// against an apiserver at apiserver. Only an update boot is refused: its
+// version file is not written yet, so greenboot rolls back onto untouched
+// data and the next update attempt retries once the control plane has
+// caught up. Refusing an already running version would only take the node
+// down, so that only warns.
+func skewVerdict(kubelet, apiserver *utilversion.Version, updateBoot bool) (refuse bool, warning string) {
+	switch {
+	case kubelet.Major() != apiserver.Major():
+		return false, fmt.Sprintf("kubelet %s and apiserver %s differ in major version", kubelet, apiserver)
+	case kubelet.Minor() > apiserver.Minor():
+		msg := fmt.Sprintf("kubelet %s is newer than the control plane's apiserver %s; the Kubernetes version skew policy needs the control plane updated first", kubelet, apiserver)
+		return updateBoot, msg
+	case apiserver.Minor()-kubelet.Minor() > maxKubeletMinorsBehind:
+		return false, fmt.Sprintf("kubelet %s is more than %d minors older than the apiserver %s, outside the version skew policy", kubelet, maxKubeletMinorsBehind, apiserver)
+	}
+	return false, ""
+}
+
+// checkWorkerSkew applies skewVerdict with the control plane reached through
+// kubeconfig. An unreachable control plane does not block: it may be
+// rebooting on the same update timer, and the healthcheck gates the worker
+// on its Node being Ready anyway.
+func checkWorkerSkew(kubeconfig string, updateBoot bool) error {
+	kubelet, err := utilversion.ParseGeneric(componentversion.Get().GitVersion)
+	if err != nil {
+		klog.Warningf("Version skew check skipped: kubelet version %q: %v", componentversion.Get().GitVersion, err)
+		return nil
+	}
+	restConfig, err := clientcmd.BuildConfigFromFlags("", kubeconfig)
+	if err != nil {
+		klog.Warningf("Version skew check skipped: %v", err)
+		return nil
+	}
+	client, err := discovery.NewDiscoveryClientForConfig(restConfig)
+	if err != nil {
+		klog.Warningf("Version skew check skipped: %v", err)
+		return nil
+	}
+	var gitVersion string
+	err = wait.PollUntilContextTimeout(context.Background(), 5*time.Second, 2*time.Minute, true,
+		func(context.Context) (bool, error) {
+			info, err := client.ServerVersion()
+			if err != nil {
+				klog.V(2).Infof("Waiting for the control plane's version: %v", err)
+				return false, nil
+			}
+			gitVersion = info.GitVersion
+			return true, nil
+		})
+	if err != nil {
+		klog.Warningf("Version skew check skipped: control plane unreachable for 2m")
+		return nil
+	}
+	apiserver, err := utilversion.ParseGeneric(gitVersion)
+	if err != nil {
+		klog.Warningf("Version skew check skipped: apiserver version %q: %v", gitVersion, err)
+		return nil
+	}
+	refuse, warning := skewVerdict(kubelet, apiserver, updateBoot)
+	if refuse {
+		return fmt.Errorf("%s: refusing to start this update", warning)
+	}
+	if warning != "" {
+		klog.Warning(warning)
+	}
+	return nil
+}
+
+// workerKubeconfig is the credential a worker reaches the control plane with:
+// the kubelet's own once it bootstrapped, the bootstrap one before.
+func workerKubeconfig(cfg *config.Config) string {
+	if exists, err := util.PathExists(cfg.KubeConfigPath(config.Kubelet)); err == nil && exists {
+		return cfg.KubeConfigPath(config.Kubelet)
+	}
+	return cfg.BootstrapKubeConfigPath()
+}
+
+// isUpdateBoot is true when this binary is not the version that last wrote
+// the data, i.e. the node is booting a new deployment.
+func isUpdateBoot() bool {
+	execVersion, err := prerun.GetVersionOfExecutable()
+	if err != nil {
+		return false
+	}
+	data := prerun.GetVersionStringOfData()
+	return data != "unknown" && data != execVersion.String()
+}
diff --git a/pkg/cmd/worker_skew_test.go b/pkg/cmd/worker_skew_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ac612d6fb4ddf15a336223341c607ed536a24d17
--- /dev/null
+++ b/pkg/cmd/worker_skew_test.go
@@ -0,0 +1,37 @@
+package cmd
+
+import (
+	"strings"
+	"testing"
+
+	utilversion "k8s.io/apimachinery/pkg/util/version"
+)
+
+func TestSkewVerdict(t *testing.T) {
+	tests := []struct {
+		name       string
+		kubelet    string
+		apiserver  string
+		updateBoot bool
+		refuse     bool
+		warning    string
+	}{
+		{"same minor", "v1.36.5", "v1.36.2", true, false, ""},
+		{"kubelet one minor older", "v1.35.8", "v1.36.5", true, false, ""},
+		{"kubelet three minors older", "v1.33.0", "v1.36.5", false, false, ""},
+		{"kubelet four minors older", "v1.32.0", "v1.36.5", false, false, "more than 3 minors older"},
+		{"kubelet newer on an update boot", "v1.36.5", "v1.35.8", true, true, "newer than the control plane"},
+		{"kubelet newer on a regular boot", "v1.36.5", "v1.35.8", false, false, "newer than the control plane"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			refuse, warning := skewVerdict(utilversion.MustParseGeneric(tt.kubelet), utilversion.MustParseGeneric(tt.apiserver), tt.updateBoot)
+			if refuse != tt.refuse {
+				t.Fatalf("refuse = %v, want %v (%q)", refuse, tt.refuse, warning)
+			}
+			if tt.warning == "" && warning != "" || !strings.Contains(warning, tt.warning) {
+				t.Fatalf("warning %q, want it to contain %q", warning, tt.warning)
+			}
+		})
+	}
+}
