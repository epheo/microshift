index 37bd5b773fae5fdb1796b6d7ffb5f9cdf05ca47b..86c06cb8425d0bc9f82b6b5a0588068d06fde374 100644
--- a/pkg/config/multinode.go
+++ b/pkg/config/multinode.go
@@ -1,14 +1,52 @@
 package config
 
+import (
+	"os"
+	"path/filepath"
+
+	"k8s.io/klog/v2"
+)
+
 type MultiNodeConfig struct {
 	Enabled bool `json:"enabled"`
+	// only one controlplane node is supported
+	// IP address of control plane node
+	Controlplane string `json:"controlplane"`
+	// Worker runs only the node services; the control plane is remote
+	Worker bool `json:"worker"`
 }
 
 // ConfigMultiNode populates multinode configurations to Config.MultiNode
-func ConfigMultiNode(c *Config, enabled bool) *Config {
+func ConfigMultiNode(c *Config, enabled bool, worker bool) *Config {
 	if !enabled {
 		return c
 	}
 	c.MultiNode.Enabled = enabled
+	c.MultiNode.Controlplane = c.Node.NodeIP
+	c.MultiNode.Worker = worker
+	if worker {
+		// The advertise address on lo would blackhole in-cluster apiserver
+		// traffic on a node that serves no API.
+		c.ApiServer.SkipInterface = true
+	}
 	return c
 }
+
+// WorkerMarkerPath is written by 'add-node --worker' so role-agnostic tools
+// (healthcheck, greenboot) can tell a worker from a control plane node.
+func WorkerMarkerPath() string {
+	return filepath.Join(DataDir, "multinode-worker")
+}
+
+func IsWorkerNode() bool {
+	_, err := os.Stat(WorkerMarkerPath())
+	if err == nil {
+		return true
+	}
+	if !os.IsNotExist(err) {
+		// A stat failure that is not "absent" (permission, SELinux) must not
+		// silently flip a worker to the control-plane health path.
+		klog.Warningf("cannot stat worker marker %s, assuming control-plane role: %v", WorkerMarkerPath(), err)
+	}
+	return false
+}
