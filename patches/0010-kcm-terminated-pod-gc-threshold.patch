diff --git a/pkg/config/kubecontrollermanager.go b/pkg/config/kubecontrollermanager.go
new file mode 100644
index 00000000..e54d8ad3
--- /dev/null
+++ b/pkg/config/kubecontrollermanager.go
@@ -0,0 +1,29 @@
+package config
+
+import "fmt"
+
+// Upstream Kubernetes' default, sized for large clusters.
+const defaultTerminatedPodGCThreshold = 12500
+
+type KubeControllerManagerConfig struct {
+	// Number of terminated pods (Succeeded or Failed) kept before the pod
+	// garbage collector deletes them, evicted pods first, then the oldest.
+	// Graceful node shutdown leaves every pod it stops as a terminated pod;
+	// a single node rarely needs more than a few dozen of them.
+	// +kubebuilder:default=12500
+	// +kubebuilder:validation:Minimum=1
+	TerminatedPodGCThreshold int32 `json:"terminatedPodGCThreshold"`
+}
+
+func kubeControllerManagerDefaults() KubeControllerManagerConfig {
+	return KubeControllerManagerConfig{
+		TerminatedPodGCThreshold: defaultTerminatedPodGCThreshold,
+	}
+}
+
+func (k *KubeControllerManagerConfig) validate() error {
+	if k.TerminatedPodGCThreshold < 1 {
+		return fmt.Errorf("terminatedPodGCThreshold must be at least 1, got %d", k.TerminatedPodGCThreshold)
+	}
+	return nil
+}
