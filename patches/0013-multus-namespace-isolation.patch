diff --git a/pkg/config/network.go b/pkg/config/network.go
index 192256ba7ed86ad3f5d09d43318b0549be71f63c..4635fe0d1eed02400bd646862cae62c1f66c1533 100644
--- a/pkg/config/network.go
+++ b/pkg/config/network.go
@@ -6,6 +6,7 @@ import (
 
 	"github.com/apparentlymart/go-cidr/cidr"
 	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/apimachinery/pkg/util/validation"
 )
 
 // CNIPlugin is an enum value that determines whether MicroShift deploys OVNK.
@@ -44,8 +45,21 @@ type Multus struct {
 	// +kubebuilder:validation:Optional
 	// +kubebuilder:default=Disabled
 	Status MultusStatusEnum `json:"status"`
+
+	// GlobalNamespaces lists the namespaces whose NetworkAttachmentDefinitions
+	// a pod in any namespace may attach to. Any other reference must stay
+	// within the pod's own namespace, as on OpenShift. A non-empty list
+	// replaces the default. Multus reads an empty list as "default", so to
+	// share no namespace, name one no tenant can write to, such as
+	// openshift-multus.
+	// +kubebuilder:validation:Optional
+	// +kubebuilder:default={"default","openshift-multus","openshift-sriov-network-operator","openshift-cnv"}
+	GlobalNamespaces []string `json:"globalNamespaces,omitempty"`
 }
 
+// OpenShift's cluster-network-operator renders Multus with these.
+var defaultMultusGlobalNamespaces = []string{"default", "openshift-multus", "openshift-sriov-network-operator", "openshift-cnv"}
+
 type Network struct {
 	// CNIPlugin is a user defined string value matching one of the above CNI values. MicroShift uses this
 	// value to decide whether to deploy the OVN-K as default CNI. An unset field defaults to "" during yaml parsing, and thus
@@ -132,5 +146,10 @@ func (m Multus) Validate() error {
 	if m.Status != MultusEnabled && m.Status != MultusDisabled {
 		return fmt.Errorf("invalid multus status: %v", m.Status)
 	}
+	for _, ns := range m.GlobalNamespaces {
+		if errs := validation.IsDNS1123Label(ns); len(errs) > 0 {
+			return fmt.Errorf("invalid multus global namespace %q: %v", ns, errs)
+		}
+	}
 	return nil
 }
