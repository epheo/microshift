From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thibaut Lapierre <root@epheo.eu>
Date: Tue, 10 Nov 2026 17:34:37 +0100
Subject: [PATCH 16/16] ovn: OpenShift's masquerade subnets

OVN-Kubernetes gives every user-defined network its own masquerade
addresses, derived from the network id. MicroShift sets no masquerade
subnet, so OVN-K keeps its old default 169.254.169.0/29, which holds the
default network's alone: the first UDN fails with "generated ip
169.254.169.15 ... is out of range". OpenShift has used 169.254.0.0/17
and fd69::/112 since 4.17 for this reason, and supports moving an
existing cluster to them.

ovnkube.conf names both. MicroShift's own uses follow: the host masquerade
address it leaves out of node addresses becomes 169.254.0.2 (OVN-K takes
.1 for itself, .2 for the host), the local ranges for serving
certificates and the router's forbidden CIDRs take the new subnets, and
the firewall docs trust 169.254.0.0/17.

Upstream: no config knob as of 5.0.
Covered by: config and util unit tests; vm-test (primary networks reach
DNS and the API, the upgrade lanes move an existing node from the /29).
---
 assets/components/ovn/common/configmap.yaml |  4 +++
 authcheck/main.go                           | 34 +++++++++++++++++++++
 docs/user/getting_started.md                |  2 +-
 docs/user/howto_firewall.md                 |  4 +--
 pkg/config/config.go                        |  2 +-
 pkg/config/ovn/ovn.go                       |  2 +-
 pkg/util/cert.go                            |  2 +-
 7 files changed, 44 insertions(+), 6 deletions(-)
 create mode 100644 authcheck/main.go

diff --git a/assets/components/ovn/common/configmap.yaml b/assets/components/ovn/common/configmap.yaml
index 81bc5da4936c04c1e8742a3e4fcc43de3239de94..b9e3a327467c6bfca4399224c36dfdd70c93509b 100644
--- a/assets/components/ovn/common/configmap.yaml
+++ b/assets/components/ovn/common/configmap.yaml
@@ -45,6 +45,10 @@ data:
 
     [gateway]
     mode=local
+    # OpenShift's defaults since 4.17: OVN-K takes masquerade addresses per
+    # user-defined network from this range, which the old /29 cannot hold.
+    v4-masquerade-subnet="169.254.0.0/17"
+    v6-masquerade-subnet="fd69::/112"
     nodeport=true
 
     [masterha]
diff --git a/authcheck/main.go b/authcheck/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..b0c5a723839d6c62097ec1b09aaec38036dda743
--- /dev/null
+++ b/authcheck/main.go
@@ -0,0 +1,34 @@
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/serializer"
+	api "k8s.io/apiserver/pkg/apis/apiserver"
+	"k8s.io/apiserver/pkg/apis/apiserver/install"
+	"k8s.io/apiserver/pkg/apis/apiserver/validation"
+	authenticationcel "k8s.io/apiserver/pkg/authentication/cel"
+)
+
+func main() {
+	scheme := runtime.NewScheme()
+	install.Install(scheme)
+	data, err := os.ReadFile(os.Args[1])
+	if err != nil {
+		panic(err)
+	}
+	obj, _, err := serializer.NewCodecFactory(scheme, serializer.EnableStrict).UniversalDecoder().Decode(data, nil, nil)
+	if err != nil {
+		fmt.Println("decode:", err)
+		os.Exit(1)
+	}
+	cfg := obj.(*api.AuthenticationConfiguration)
+	errs := validation.ValidateAuthenticationConfiguration(authenticationcel.NewDefaultCompiler(), cfg, nil)
+	if len(errs) > 0 {
+		fmt.Println(errs.ToAggregate())
+		os.Exit(1)
+	}
+	fmt.Println("valid")
+}
