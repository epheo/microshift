+// externalKubeconfigNames are the names that get a kubeconfig under
+// resources/kubeadmin. The advertise address is always one: it is the node IP
+// 'worker-join-kubeconfig' defaults to.
+func externalKubeconfigNames(cfg *config.Config) []string {
+	names := append(slices.Clone(cfg.ApiServer.SubjectAltNames), cfg.Node.HostnameOverride)
+	for _, ip := range cfg.ApiServer.AdvertiseAddresses {
+		if !slices.Contains(names, ip) {
+			names = append(names, ip)
+		}
+	}
+	return names
+}
+
 func cleanupStaleKubeconfigs(cfg *config.Config, path string) error {
 	currentKubeconfigs := make(map[string]struct{})
-	for _, name := range append(cfg.ApiServer.SubjectAltNames, cfg.Node.HostnameOverride) {
+	for _, name := range externalKubeconfigNames(cfg) {
 		currentKubeconfigs[name] = struct{}{}
 	}
 	dirs, err := os.ReadDir(path)
