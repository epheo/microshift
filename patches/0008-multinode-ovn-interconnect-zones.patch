+
+// addWorkerGatewayConfig gives a worker the dataplane a control plane node
+// gets from addServiceIPLoopback, without the blackhole:
+//   - ovnkube's gateway init refuses to start without an IPv4 on br-ex.
+//     OCP puts the node IP on br-ex; mirror that as a /32 alias on the
+//     virtual bridge, which also makes the gateway IP this node advertises
+//     to other zones genuinely routable.
+//   - the virtual advertise address must leave the node: without a route
+//     via the control plane, pod traffic to the apiserver endpoint
+//     dead-ends locally (the original multinode CNI failure).
+func (n *NetworkConfiguration) addWorkerGatewayConfig() error {
+	link, err := netlink.LinkByName(ovn.OVNGatewayInterface)
+	if err != nil {
+		// br-ex is created by microshift-ovs-init; systemd restarts us
+		// until it exists.
+		return fmt.Errorf("worker node needs %s: %w", ovn.OVNGatewayInterface, err)
+	}
+
+	// A node repurposed from controller to worker still carries the
+	// advertise address from its control plane life; a local address wins
+	// over any route, so it would swallow all apiserver endpoint traffic.
+	n.removeAdvertiseAddresses()
+
+	nodeAddr, err := netlink.ParseAddr(hostCIDR(n.nodeIP))
+	if err != nil {
+		return err
+	}
+	existing, err := netlink.AddrList(link, netlink.FAMILY_ALL)
+	if err != nil {
+		return err
+	}
+	present := false
+	for _, a := range existing {
+		if nodeAddr.Equal(a) {
+			present = true
+			break
+		}
+	}
+	if !present {
+		if err := netlink.AddrAdd(link, nodeAddr); err != nil {
+			return err
+		}
+	}
+
+	gw := net.ParseIP(n.controlplaneIP)
+	if gw == nil || n.controlplaneIP == n.nodeIP {
+		// Pre-join (no marker yet) there is nowhere to route to; the
+		// post-join restart comes back through here with the marker set.
+		klog.Infof("no control plane address yet, skipping advertise address routes")
+		return nil
+	}
+	for _, entry := range n.kasAdvertiseAddresses {
+		ip := net.ParseIP(entry)
+		if ip == nil || (ip.To4() == nil) != (gw.To4() == nil) {
+			continue
+		}
+		prefix := 32
+		if ip.To4() == nil {
+			prefix = 128
+		}
+		_, dst, err := net.ParseCIDR(fmt.Sprintf("%s/%d", entry, prefix))
+		if err != nil {
+			return err
+		}
+		if err := netlink.RouteReplace(&netlink.Route{Dst: dst, Gw: gw}); err != nil {
+			return fmt.Errorf("failed to route %s via %s: %w", entry, n.controlplaneIP, err)
+		}
+	}
+	return nil
+}
+
+func (n *NetworkConfiguration) removeWorkerGatewayConfig() {
+	if gw := net.ParseIP(n.controlplaneIP); gw != nil && n.controlplaneIP != n.nodeIP {
+		for _, entry := range n.kasAdvertiseAddresses {
+			ip := net.ParseIP(entry)
+			if ip == nil || (ip.To4() == nil) != (gw.To4() == nil) {
+				continue
+			}
+			prefix := 32
+			if ip.To4() == nil {
+				prefix = 128
+			}
+			_, dst, err := net.ParseCIDR(fmt.Sprintf("%s/%d", entry, prefix))
+			if err != nil {
+				continue
+			}
+			if err := netlink.RouteDel(&netlink.Route{Dst: dst, Gw: gw}); err != nil {
+				klog.Warningf("failed to remove route to %s: %v", entry, err)
+			}
+		}
+	}
+	link, err := netlink.LinkByName(ovn.OVNGatewayInterface)
+	if err != nil {
+		return
+	}
+	if addr, err := netlink.ParseAddr(hostCIDR(n.nodeIP)); err == nil {
+		if err := netlink.AddrDel(link, addr); err != nil {
+			klog.Warningf("failed to remove %s from %s: %v", n.nodeIP, ovn.OVNGatewayInterface, err)
+		}
+	}
+}
+
+func hostCIDR(ip string) string {
+	if net.ParseIP(ip).To4() == nil {
+		return ip + "/128"
+	}
+	return ip + "/32"
+}
+
+func (n *NetworkConfiguration) removeAdvertiseAddresses() {
+	for _, name := range []string{ovn.OVNGatewayInterface, loopbackInterface} {
+		link, err := netlink.LinkByName(name)
+		if err != nil {
+			continue
+		}
+		for _, entry := range n.kasAdvertiseAddresses {
+			prefix := 32
+			if net.ParseIP(entry).To4() == nil {
+				prefix = 128
+			}
+			addr, err := netlink.ParseAddr(fmt.Sprintf("%s/%d", entry, prefix))
+			if err != nil {
+				continue
+			}
+			existing, err := netlink.AddrList(link, netlink.FAMILY_ALL)
+			if err != nil {
+				continue
+			}
+			for _, existingAddr := range existing {
+				if addr.Equal(existingAddr) {
+					if err := netlink.AddrDel(link, addr); err != nil {
+						klog.Warningf("failed to remove stale advertise address %s from %s: %v", entry, name, err)
+					} else {
+						klog.Infof("removed stale advertise address %s from %s", entry, name)
+					}
+				}
+			}
+		}
+	}
+}
