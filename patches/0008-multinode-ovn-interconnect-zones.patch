diff --git a/assets/components/ovn/common/clusterrole-controller.yaml b/assets/components/ovn/common/clusterrole-controller.yaml
index be69d281..5615de7a 100644
--- a/assets/components/ovn/common/clusterrole-controller.yaml
+++ b/assets/components/ovn/common/clusterrole-controller.yaml
@@ -115,3 +115,29 @@ rules:
 - apiGroups: ['authorization.k8s.io']
   resources: ['subjectaccessreviews']
   verbs: ['create']
+# Leader election. Single-node runs with the kubeadmin kubeconfig and never
+# consults this role; multinode pods authenticate with the pod service
+# account, which makes these rules load-bearing.
+- apiGroups: ["coordination.k8s.io"]
+  resources:
+  - leases
+  verbs:
+  - create
+  - get
+  - list
+  - watch
+  - update
+  - patch
+  - delete
+# enable-multi-network makes the shared informer factory list these at
+# startup; a forbidden response is fatal for every ovnkube process.
+- apiGroups: ["k8s.cni.cncf.io"]
+  resources:
+  - network-attachment-definitions
+  verbs:
+  - get
+  - list
+  - watch
+  - create
+  - update
+  - patch
