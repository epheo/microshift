 .../ovn/common/clusterrole-controller.yaml    | 65 +++++++++++++++++++
 assets/components/ovn/common/configmap.yaml   | 10 +++
 .../ovn/single-node/master/daemonset.yaml     | 25 ++++++-
 .../ovn/zones/master/daemonset.yaml           | 12 +++-
 .../components/ovn/zones/node/daemonset.yaml  | 19 ++++++
 pkg/assets/crd.go                             |  3 +
 6 files changed, 132 insertions(+), 2 deletions(-)

diff --git a/assets/components/ovn/common/clusterrole-controller.yaml b/assets/components/ovn/common/clusterrole-controller.yaml
index 8aaa4e18682cacd85e3abbbcca12f768906df4af..290b77313f97fdecf94812ba3ac1e073ed421894 100644
--- a/assets/components/ovn/common/clusterrole-controller.yaml
+++ b/assets/components/ovn/common/clusterrole-controller.yaml
@@ -177,3 +177,68 @@ rules:
   - egressfirewalls/status
   verbs:
   - patch
+# enable-network-segmentation: the cluster manager renders each UDN and CUDN
+# into NADs in the namespaces it selects, deletes them with the network, and
+# owns the networks' status and finalizers. Same crash loop when forbidden.
+- apiGroups: ["k8s.ovn.org"]
+  resources:
+  - userdefinednetworks
+  - clusteruserdefinednetworks
+  verbs:
+  - get
+  - list
+  - watch
+  - patch
+  - update
+- apiGroups: ["k8s.ovn.org"]
+  resources:
+  - userdefinednetworks/status
+  - clusteruserdefinednetworks/status
+  verbs:
+  - patch
+  - update
+- apiGroups: ["k8s.ovn.org"]
+  resources:
+  - userdefinednetworks/finalizers
+  - clusteruserdefinednetworks/finalizers
+  verbs:
+  - update
+- apiGroups: ["k8s.cni.cncf.io"]
+  resources:
+  - network-attachment-definitions
+  verbs:
+  - delete
+# It also mirrors each Service's EndpointSlices into every user-defined
+# network, with the pods' addresses there: without these, a UDN Service has
+# no endpoints.
+- apiGroups: ["discovery.k8s.io"]
+  resources:
+  - endpointslices
+  verbs:
+  - get
+  - create
+  - update
+  - delete
+# The mirrored slices are owned by their Service (blockOwnerDeletion), which
+# the apiserver only lets a client set with update on services/finalizers:
+# without it every mirror is forbidden. OpenShift's control plane holds it.
+- apiGroups: [""]
+  resources:
+  - services/finalizers
+  verbs:
+  - update
+# --enable-persistent-ips: the cluster manager records each claimed address
+# in the IPAMClaim's status, so a VM keeps it across restarts and migrations.
+- apiGroups: ["k8s.cni.cncf.io"]
+  resources:
+  - ipamclaims
+  verbs:
+  - get
+  - list
+  - watch
+- apiGroups: ["k8s.cni.cncf.io"]
+  resources:
+  - ipamclaims/status
+  verbs:
+  - patch
+  - update
diff --git a/assets/components/ovn/common/configmap.yaml b/assets/components/ovn/common/configmap.yaml
index 95ed0e71bc6f192c5a746aff4ce31b6b2882d2a5..4c3ab2fc56084b5250b9615ea4d3fcdf12038baa 100644
--- a/assets/components/ovn/common/configmap.yaml
+++ b/assets/components/ovn/common/configmap.yaml
@@ -13,6 +13,7 @@ data:
     encap-port="6081"
     enable-lflow-cache=false
     lflow-cache-limit-kb=870
+    udn-allowed-default-services="default/kubernetes,openshift-dns/dns-default"
 
     [kubernetes]
     service-cidrs={{.ServiceCIDR}}
@@ -23,6 +24,8 @@ data:
     kubeconfig={{.KubeconfigPath}}
 {{- end }}
     host-network-namespace="openshift-host-network"
+    dns-service-namespace="openshift-dns"
+    dns-service-name="dns-default"
     platform-type="BareMetal"
 
     [ovnkubernetesfeature]
@@ -32,6 +35,13 @@ data:
     enable-multi-network=true
     enable-multi-networkpolicy=true
     enable-admin-network-policy=true
+    enable-network-segmentation=true
+    enable-preconfigured-udn-addresses=true
+
+    [ovnkubenode]
+    # kubelet runs inside microshift.service: UDN host isolation lets this
+    # cgroup's sockets reach primary-network pods, for kubelet probes.
+    kubelet-cgroup-path="system.slice/microshift.service"
 
     [gateway]
     mode=shared
diff --git a/assets/components/ovn/single-node/master/daemonset.yaml b/assets/components/ovn/single-node/master/daemonset.yaml
index f2b9700e638040da23b39e2787d15f8b8133794b..c7748ce1a09a8000217a55a84ddf6655aa3144ab 100644
--- a/assets/components/ovn/single-node/master/daemonset.yaml
+++ b/assets/components/ovn/single-node/master/daemonset.yaml
@@ -318,7 +318,8 @@ spec:
             --init-cluster-manager "${K8S_NODE}" \
             --config-file=/run/ovnkube-config/ovnkube.conf \
             --loglevel "${OVN_KUBE_LOG_LEVEL}" \
-            --enable-multicast
+            --enable-multicast \
+            --enable-persistent-ips
         env:
         - name: OVN_KUBE_LOG_LEVEL
           value: "4"
@@ -327,6 +328,9 @@ spec:
             fieldRef:
               fieldPath: spec.nodeName
         volumeMounts:
+        - mountPath: /usr/bin/ovnkube
+          name: microshift-ovnkube
+          readOnly: true
         - mountPath: /run/ovnkube-config/
           name: ovnkube-config
         - mountPath: {{.KubeconfigDir}}
@@ -426,6 +430,16 @@ spec:
           initialDelaySeconds: 5
           periodSeconds: 5
         volumeMounts:
+        # UDN host isolation follows the kubelet unit's restarts over systemd's
+        # private socket, as OpenShift mounts it.
+        - mountPath: /run/systemd/private
+          name: run-systemd
+          subPath: private
+          readOnly: true
+          mountPropagation: HostToContainer
+        - mountPath: /usr/bin/ovnkube
+          name: microshift-ovnkube
+          readOnly: true
         # for checking ovs-configuration service
         - mountPath: /etc/systemd/system
           name: systemd-units
@@ -531,5 +545,14 @@ spec:
         configMap:
           name: env-overrides
           optional: true
+      # The image's ovnkube plus the OVN-K fixes in src/ovn/, built by
+      # src/ovn/build-ovnkube.sh until the payload carries them.
+      - name: microshift-ovnkube
+        hostPath:
+          path: /usr/libexec/microshift-ovnkube
+          type: File
+      - name: run-systemd
+        hostPath:
+          path: /run/systemd
       tolerations:
       - operator: "Exists"
