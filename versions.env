# Single source of truth for every pinned input of the build.
# Bumped by scripts/bump-versions.sh (via the scheduled bump workflow) or by hand.

# openshift/microshift source ref. Pin release (ART) tags, not branches, so
# builds are reproducible. The bump workflow advances this to the newest GA
# tag — crossing minors on its own once a stable OKD payload of that minor
# exists (see scripts/bump-versions.sh).
USHIFT_GIT_URL=https://github.com/openshift/microshift.git
USHIFT_GITREF=5.0.0-202610291612.p0

# OKD payload the component images are swapped to (quay.io/okd/scos-release
# tags). Stay on stable (-okd-scos.N) tags of the same minor as USHIFT_GITREF.
OKD_VERSION_TAG=5.0.0-okd-scos.5
OKD_RELEASE_IMAGE=quay.io/okd/scos-release

# Base images. The RPM buildroot is CentOS Stream 10, so the RPMs are native
# el10. Its golang must satisfy the go directive in upstream's go.mod;
# rpm.Containerfile sets GOTOOLCHAIN=auto in case it ever falls behind.
BOOTC_IMAGE_URL=quay.io/centos-bootc/centos-bootc
BOOTC_IMAGE_TAG=stream10
BUILDROOT_IMAGE=quay.io/centos/centos:stream10

# Edge component shipped by this distribution (embedded as an OCI archive,
# imported into cri-o's store at boot — see src/embedded-images/).
PORTAIL_IMAGE=ghcr.io/epheo/portail:0.2.1

# r-drbd (github.com/epheo/r-drbd) is the storage driver: its deploy/base at
# this commit is vendored into src/r-drbd/base by src/r-drbd/vendor.sh,
# image pin included. Bumped by hand, with the vendored files.
R_DRBD_COMMIT=28663a9ee03cc236fb5479218fff6096c72697e9

# DRBD 9 kernel module for r-drbd, built in the bootc stage against the
# image's own kernel. Pinned by version and checksum, bumped by hand.
DRBD_VERSION=9.3.4
DRBD_SHA256=a2de4b7ffc43fdabad01b0bf7283b910eb6401b0f788e33a65ae94fc0588545c

# Gateway API CRDs for portail, experimental channel: TCPRoute and UDPRoute
# exist only there. Not auto-bumped: experimental route versions change between
# bundles, so this moves by hand with the bundle portail is tested against.
GATEWAY_API_VERSION=v1.4.1
GATEWAY_API_SHA256=553327e0ff32a1a2be446bf93823c8413cf9253ac6a6d5407eebd1e8d269f69e

# Revision of this repo's patch/opinion set. Bump when patches/ or the
# opinionated configuration changes without any upstream version change.
# scripts/bump-versions.sh bumps it with a portail-only bump.
EPHEO_REV=36
