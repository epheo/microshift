[Unit]
Description=Build the installer's data disks into VG myvg1, thin pool thin
Documentation=https://github.com/epheo/microshift#installer
ConditionPathExists=/etc/amorce/data-disks.json
ConditionPathExists=!/var/lib/microshift-r-drbd/data-disks-built
After=local-fs.target
Before=microshift-r-drbd-default-pool.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/microshift-r-drbd-data-disks

[Install]
WantedBy=multi-user.target
