#!/bin/bash
# Updates in a cluster: the controller leads, workers follow.
# The controller updates on bootc's own timer and, once a boot is green,
# publishes the exact image it booted. Workers switch to that image and to no
# other: a worker is then never newer than the control plane (Kubernetes
# version skew policy), and never meets an update the controller rolled back.
# One node at a time, and only while every r-drbd Volume is fully replicated:
# a second node down could take a replicated volume below quorum.
# A single node is a controller.
#
#   when <role>       ExecCondition: this node has the role, its boot is not red
#   publish           controller, once per green boot
#   follow            worker, on a timer
#   gate              ExecCondition of bootc-fetch-apply-updates.service
#   record-rollback   greenboot red.d
set -euo pipefail

NS=kube-public
NAME=microshift-update
# Held by the one node updating. A ConfigMap, not a Lease: NodeRestriction
# lets a node write no Lease but its own, in kube-node-lease.
LOCK=microshift-update-lock
ADMIN_KUBECONFIG=/var/lib/microshift/resources/kubeadmin/kubeconfig
NODE_KUBECONFIG=/var/lib/microshift/resources/kubelet/kubeconfig
# On /var, so it outlives the deployment that wrote it.
ROLLED_BACK=/var/lib/microshift-update/rolled-back
# A node that never comes back stops holding the lock after this; its
# Volumes stay Degraded, so nobody else reboots anyway.
LOCK_SECS=3600

booted() { bootc status --json | jq -r ".status.booted.image.$1 // empty"; }

rolled_back() { [ -n "$1" ] && [ -f "${ROLLED_BACK}" ] && grep -qxF "$1" "${ROLLED_BACK}"; }

# The repository without tag or digest: workers get the digest, so a tag that
# moved since the controller booted cannot take them elsewhere.
repo_of() {
    local ref="${1%@*}"
    case "${ref##*/}" in *:*) ref="${ref%:*}" ;; esac
    echo "${ref}"
}

# Every node, the controller included, uses its kubelet's credential for the
# lock and the Volumes: src/update/manifests grants system:nodes just that.
noc() { oc --kubeconfig "${NODE_KUBECONFIG}" "$@"; }

node_name() {
    local user
    user="$(noc auth whoami -o jsonpath='{.status.userInfo.username}')" || return 1
    case "${user}" in system:node:?*) echo "${user#system:node:}" ;; *) return 1 ;; esac
}

# Fails, saying why, while a reboot could take a Volume below quorum: r-drbd
# services one node at a time and waits for every Volume to be Ready.
storage_settled() {
    local out res busy
    if ! out="$(noc get volumes.r-drbd.io -o json)"; then
        # Only a cluster without r-drbd at all has nothing to keep in quorum.
        res="$(noc api-resources --api-group=r-drbd.io -o name)" && [ -z "${res}" ] && return 0
        echo "cannot read the r-drbd Volumes"
        return 1
    fi
    busy="$(jq -r '.items[] | select(.status.phase == "Degraded" or .status.phase == "Provisioning")
        | "\(.metadata.name) \(.status.phase)"' <<<"${out}")" || {
        echo "cannot parse the r-drbd Volumes"
        return 1
    }
    [ -z "${busy}" ] && return 0
    echo "waiting for every Volume to be Ready:"
    echo "${busy}"
    return 1
}

expired() { [ -z "$1" ] || [ "$(date -u -d "$1" +%s)" -lt "$(date -u +%s)" ]; }

# The write carries the resourceVersion just read: two nodes racing for a
# free lock, one gets a conflict.
lock() {
    local me=$1 cm holder expires
    cm="$(noc -n "${NS}" get configmap "${LOCK}" -o json)" || { echo "cannot read the update lock"; return 1; }
    holder="$(jq -r '.data.holder // empty' <<<"${cm}")"
    if [ -n "${holder}" ] && [ "${holder}" != "${me}" ] \
            && ! expired "$(jq -r '.data.expires // empty' <<<"${cm}")"; then
        echo "${holder} is updating; waiting for it"
        return 1
    fi
    expires="$(date -u -d "+${LOCK_SECS} seconds" +%Y-%m-%dT%H:%M:%SZ)"
    jq --arg me "${me}" --arg expires "${expires}" \
        'del(.metadata.managedFields) | .data.holder = $me | .data.expires = $expires' <<<"${cm}" \
        | noc replace -f - >/dev/null || { echo "could not take the update lock"; return 1; }
}

# Run on a green boot: an update this node started is over, done or rolled back.
unlock() {
    local me=$1 cm
    cm="$(noc -n "${NS}" get configmap "${LOCK}" -o json)"
    [ "$(jq -r '.data.holder // empty' <<<"${cm}")" = "${me}" ] || return 0
    jq 'del(.metadata.managedFields, .data.holder, .data.expires)' <<<"${cm}" \
        | noc replace -f - >/dev/null
    echo "released the update lock"
}

when() {
    [ "$(microshift-profile)" = "$1" ] || exit 1
    # A red boot is greenboot's to resolve: it reboots or rolls back. Inactive
    # means greenboot is not in charge of this boot.
    case "$(systemctl show -P ActiveState greenboot-healthcheck.service)" in
        active|inactive) exit 0 ;;
        *) exit 1 ;;
    esac
}

publish() {
    local digest image me
    digest="$(booted imageDigest)"
    [ -n "${digest}" ] || { echo "bootc reports no booted image" >&2; return 1; }
    image="$(repo_of "$(booted image.image)")@${digest}"
    oc --kubeconfig "${ADMIN_KUBECONFIG}" -n "${NS}" create configmap "${NAME}" \
        --from-literal=image="${image}" \
        --from-literal=transport="$(booted image.transport)" \
        --dry-run=client -o yaml \
        | oc --kubeconfig "${ADMIN_KUBECONFIG}" apply --server-side \
            --field-manager=microshift-update -f - >/dev/null
    echo "published ${image} for workers to follow"
    me="$(node_name)"
    unlock "${me}"
}

follow() {
    local me target transport image digest
    if [ ! -f "${NODE_KUBECONFIG}" ]; then
        echo "not joined to a cluster yet"
        return 0
    fi
    # The controller may be rebooting into its own update: try again later.
    if ! me="$(node_name)" || ! target="$(noc -n "${NS}" get configmap "${NAME}" \
            -o jsonpath='{.data.transport} {.data.image}')"; then
        echo "the controller is unreachable or has published nothing yet"
        return 0
    fi
    unlock "${me}"
    read -r transport image <<<"${target}"
    [ -n "${image}" ] || return 0
    digest="${image##*@}"
    [ "${digest}" != "$(booted imageDigest)" ] || return 0
    if rolled_back "${digest}"; then
        echo "not following ${image}: greenboot rolled it back on this node"
        return 0
    fi
    storage_settled || return 0
    lock "${me}" || return 0
    echo "following the controller to ${image}"
    bootc switch --apply --transport "${transport}" "${image}"
}

gate() {
    local digest me
    # Unchecked, a reboot can take a replicated Volume below quorum: when in
    # doubt, wait for the next run.
    set -o errtrace
    trap 'echo "update gate failed; skipping this run"; exit 1' ERR
    if [ "$(microshift-profile)" = worker ]; then
        echo "workers follow the controller's image instead (microshift-update-follow.timer)"
        exit 1
    fi
    bootc upgrade --check >/dev/null
    digest="$(bootc status --json | jq -r '.status.booted.cachedUpdate.imageDigest // empty')"
    if [ -z "${digest}" ] || [ "${digest}" = "$(booted imageDigest)" ]; then
        echo "no update"
        exit 1
    fi
    if rolled_back "${digest}"; then
        echo "skipping ${digest}: greenboot rolled it back on this node."
        echo "A new image, or a manual 'bootc upgrade --apply', ends this."
        exit 1
    fi
    me="$(node_name)"
    unlock "${me}"
    storage_settled || exit 1
    lock "${me}" || exit 1
    echo "updating to ${digest}"
}

record_rollback() {
    local env digest
    # MicroShift's own red.d script reads the same counter: at zero, greenboot
    # rolls back right after red.d.
    env="$(grub2-editenv - list)"
    grep -qx 'boot_counter=0' <<<"${env}" || return 0
    digest="$(booted imageDigest)"
    [ -n "${digest}" ] || return 0
    mkdir -p "${ROLLED_BACK%/*}"
    rolled_back "${digest}" || echo "${digest}" >> "${ROLLED_BACK}"
    echo "updates skip ${digest} from now on"
}

case "${1:-}" in
    when) when "${2:?role}" ;;
    publish) publish ;;
    follow) follow ;;
    gate) gate ;;
    record-rollback) record_rollback ;;
    *) echo "Usage: $0 when <controller|worker>|publish|follow|gate|record-rollback" >&2; exit 2 ;;
esac
