[Unit]
Description=Import embedded container images into the cri-o image store
# Before MicroShift so boot-critical pods (portail, and whatever a site layer
# embeds) find their localhost/embedded/* images locally instead of pulling.
After=local-fs.target
Before=microshift.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/import-embedded-images.sh

[Install]
WantedBy=multi-user.target
